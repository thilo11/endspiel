# ── Rust / Cargo build artifacts ──
# Cargo.lock IS tracked (shipped binary → reproducible builds)
target/
**/*.rs.bk
.cargo/config.toml

# ── Editors, IDEs, OS cruft ──
*~
*.swo
*.swp
.DS_Store
.idea/
.vscode/

# ── Python (lichess-bot analysis scripts) ──
__pycache__/
*.pyc
.venv/

# ── Local environment & config (incl. chess-tuner output) ──
.envrc
config.json
tuned_params.json

# ── Local-only assets & nets (books, tablebases, openings) ──
assets/

# ── Local-only tooling, analysis & scratch ──
.claude/
/lichess/
debug_*.py
debug_*.sh
test_*.sh

# ── Build / run outputs & release artifacts ──
/dist/
endspiel-*
